{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "index.py": {
      "maxDuration": 60,
      "includeFiles": "jinni/data_files/**",
      "excludeFiles": "{tests/**,legacy/**,app/**,assets/**,docs/**,.devcontainer/**,.streamlit/**,public/**,*.md,streamlit_app.py,dev.py,main.py,run.py,config.py,firebase_config.py,risk_analytics.py,portfolio_optimizer.py,continuous_learner.py,advanced_models.py,autonomous_market_analyzer.py,automated_retraining.py,recommendation_engine.py,local_storage.py,performance_tracker.py,online_learning/**,ml_models/**,analytics/**,data_scraper/**,dashboard/**,utils/**}"
    }
  },
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(icon-.*\\.png|apple-touch-icon\\.png|favicon\\.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
